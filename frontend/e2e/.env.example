# MoveToData – Playwright E2E environment variables
# Copy this file to e2e/.env (or set variables in CI/CD) before running tests.
# Never commit real credentials.

# Base URL of the running frontend (defaults to http://localhost:3000)
BASE_URL=http://localhost:3000

# Test user credentials
# The user must exist on the target environment and have sufficient permissions.
TEST_USER=admin
TEST_PASSWORD=admin
